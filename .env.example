# IPET Lead Hub · 环境变量样例
# 复制到 Vercel Project → Settings → Environment Variables
# 切勿提交真实值到 Git

# TypeSafe System One（在 TypeSafe 控制台重新生成，旧 key 已泄露必须作废）
TYPESAFE_API_KEY=

# 前端访问令牌（用户在页面输入的同一字符串；请用长随机串）
# 生成建议: openssl rand -hex 32
HUB_API_TOKEN=

# 可选：Webhook 专用密钥（WordPress / Zapier 调用 /api/ingest 时带 X-Hub-Secret）
HUB_WEBHOOK_SECRET=

# GitHub Contents API 写回 cloud_leads.json
GITHUB_TOKEN=
REPO_OWNER=wallysuda
REPO_NAME=ipet-lead-hub

# 允许的跨域来源（逗号分隔）。同源始终允许。
# 例: https://temporary-rushing-mesa-lbb9pzn.vercel.app,http://localhost:3000
HUB_ALLOWED_ORIGINS=

# 存储驱动: github (默认) | file (本地开发)
LEAD_STORE=github

# 腾讯企业邮 IMAP（回复抓取闭环）
# 用户：邮箱账号，PASS：客户端专用密码（不是登录密码）
MAIL_IMAP_HOST=imap.exmail.qq.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=you@your-domain.com
MAIL_IMAP_PASS=
MAIL_FOLDER=INBOX
MAIL_FETCH_DAYS=7
MAIL_FETCH_MAX=40
